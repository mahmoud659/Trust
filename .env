# ── Resemble AI Detect (read by the FastAPI backend only) ──────────────────
# Get your key from https://app.resemble.ai → Account → API
RESEMBLE_API_KEY=5aijjO4vBlXrYn3kxBLATgtt

# Set to false to turn the AI layer off (verdict becomes REVIEW, not TRUSTED)
AI_DETECTION_ENABLED=true

# Resemble score: 0 = real, 1 = AI-generated
AI_REVIEW_THRESHOLD=0.50
AI_REJECT_THRESHOLD=0.85

# Ask Resemble to delete the media after analysis (recommended for claim evidence)
RESEMBLE_ZERO_RETENTION=true

# Seconds to wait for Resemble (single request / total including polling)
RESEMBLE_TIMEOUT_SECONDS=60
RESEMBLE_MAX_WAIT_SECONDS=90

# Optional overrides
# RESEMBLE_BASE_URL=https://app.resemble.ai/api/v2
# TRUSTCAP_API_URL=http://localhost:8000   # used by the Streamlit app

AUTH_EMAIL=demo@trustcap.local
